# fireassay
artifacts/
spike/spike.db
.cache/
spike/corpus_small.jsonl
spike/gen.db
spike/*.db
spike/*.jsonl

# the real run's LLM cache is the checkpoint for a multi-hour generation
# run - losing it means losing hours of model time. Smoke caches stay ignored.
!.cache/llm/
!.cache/llm/responses.jsonl

# the answerability judge's cache is a separate OllamaClient/cache pair from
# generate_json's -- it must never collide with .cache/llm/'s checkpoint
# (same (model, prompt) key, different response shape: free text vs JSON).
# Not negated: unlike .cache/llm/, it is a disposable re-run cache, not a
# checkpoint worth committing.
.cache/judge/

# the dense retriever's embedding cache: ~40,921 chunk vectors plus the
# panel's question vectors, about 170 MB and roughly 80 minutes of local
# model time. Covered by `.cache/` above and named here for the same
# reason `.cache/judge/` is: it is a disposable re-run cache, NOT a
# checkpoint worth committing, and the dense numbers it backs are
# reproduced from run/panel_dense_matrix.csv, never from these bytes.
.cache/embeddings/

# per-(retriever, chunking) resume files for tools/panel_dense.py --
# minutes of BM25, not hours of model time; rebuilt on demand.
.cache/panel_dense/

# raw measurement artifacts behind handbook/eval-of-evals.md's claims -
# a number without a reproducible artifact is an assertion
!run/item_analysis.json
!run/matrix200.json
